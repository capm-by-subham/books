{
  "name": "books",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-book": "cds watch --open book/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-books_list": "cds watch --open bookslist/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-book-sales-alp": "cds watch --open booksalesalp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-launchpad": "cds watch --open launchpad.html --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/books_list",
    "app/book-sales-alp"
  ]
}
