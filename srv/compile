
CREATE TABLE CatalogService_Books (
  ID INTEGER NOT NULL,
  title NVARCHAR(255),
  author NVARCHAR(255),
  stock INTEGER DEFAULT 0,
  writer_ID INTEGER,
  PRIMARY KEY(ID)
);

CREATE TABLE CatalogService_Authors (
  ID INTEGER NOT NULL,
  name NVARCHAR(255),
  PRIMARY KEY(ID)
);

CREATE TABLE CatalogService_Authors_addresses (
  up__ID INTEGER NOT NULL,
  ID INTEGER NOT NULL,
  street NVARCHAR(255),
  city NVARCHAR(255),
  country NVARCHAR(255),
  PRIMARY KEY(up__ID, ID)
);

